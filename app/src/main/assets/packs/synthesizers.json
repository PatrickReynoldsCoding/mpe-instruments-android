{
  "id": "synthesizers",
  "name": "Synthesizers",
  "order": 5,
  "description": "Pads, leads and basses: plain subtractive, FM and additive synths. Quick sketches.",
  "source": "https://github.com/PatrickReynoldsCoding/faust-mpe-instruments",
  "defaults": {
    "reverb": 0.25,
    "reverbSize": 0.35,
    "reverbDamp": 0.4,
    "delay": 0.12,
    "brightness": 1,
    "drive": 0,
    "pressureCurve": 1,
    "release": 0
  },
  "groups": [
    {
      "id": "pads",
      "name": "Pads",
      "instruments": [
        "synths/pad",
        "synths/string-machine",
        "synths/glass-pad",
        "synths/brass-synth"
      ]
    },
    {
      "id": "leads",
      "name": "Leads",
      "instruments": [
        "synths/lead",
        "synths/supersaw",
        "synths/square-lead",
        "synths/sync-lead",
        "synths/chip-lead",
        "synths/pluck-synth"
      ]
    },
    {
      "id": "basses",
      "name": "Basses",
      "instruments": [
        "synths/sub-bass",
        "synths/acid-bass",
        "synths/wobble-bass"
      ]
    }
  ],
  "overrides": {
    "synths/sub-bass": {
      "reverb": 0.05,
      "reverbSize": 0.245,
      "reverbDamp": 0.4,
      "delay": 0,
      "brightness": 1,
      "drive": 0,
      "pressureCurve": 1,
      "release": 0
    },
    "synths/acid-bass": {
      "reverb": 0.05,
      "reverbSize": 0.245,
      "reverbDamp": 0.4,
      "delay": 0.2,
      "brightness": 1,
      "drive": 0,
      "pressureCurve": 1,
      "release": 0
    },
    "synths/wobble-bass": {
      "reverb": 0.05,
      "reverbSize": 0.245,
      "reverbDamp": 0.4,
      "delay": 0,
      "brightness": 1,
      "drive": 0,
      "pressureCurve": 1,
      "release": 0
    }
  }
}
