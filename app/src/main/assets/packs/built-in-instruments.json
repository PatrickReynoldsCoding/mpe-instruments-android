{
  "id": "built-in-instruments",
  "name": "Built-in instruments",
  "description": "Physical models and synths from faust-mpe-instruments: strings fitted to solo recordings, a piano fitted to a Steinway, voices, winds and a drum kit.",
  "source": "https://github.com/PatrickReynoldsCoding/faust-mpe-instruments",
  "defaults": {
    "comment": "As the instruments' own host plays them: the hall (src/room.dsp, zita_rev1: 2.0 s, 2.4 s low, 25 ms, 6 kHz) at amount 0.5, nothing else.",
    "reverb": 0.475,
    "reverbSize": 0.245,
    "reverbDamp": 0.4,
    "delay": 0,
    "brightness": 1,
    "drive": 0,
    "pressureCurve": 1,
    "release": 0
  },
  "groups": [
    { "id": "strings", "name": "Strings", "instruments": ["strings/cello", "strings/violin"] },
    { "id": "keys", "name": "Keys", "instruments": ["keys/piano", "synths/fm-keys"] },
    { "id": "plucked", "name": "Plucked", "instruments": ["plucked/nylon-guitar", "plucked/steel-guitar"] },
    { "id": "struck", "name": "Struck", "instruments": ["struck/marimba", "struck/vibraphone"] },
    { "id": "winds", "name": "Winds", "instruments": ["winds/flute", "winds/clarinet"] },
    { "id": "voices", "name": "Voices", "instruments": ["voices/soprano", "voices/tenor", "voices/bass"] },
    { "id": "synths", "name": "Synths", "instruments": ["synths/pad", "synths/lead"] },
    { "id": "drums", "name": "Drums", "instruments": ["drums/kit"] }
  ]
}
